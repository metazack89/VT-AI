{
  "name": "visiontext-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix frontend",
    "dev": "concurrently \"npm run dev --prefix frontend\" \"cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}
